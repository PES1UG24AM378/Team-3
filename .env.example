# Environment Variables Template
# Copy this file to .env in your root or backend directory and customize. Never commit real secrets.

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration (PostgreSQL)
# Use DATABASE_URL or individual credentials
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tutoring_scheduler
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tutoring_scheduler
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication Secrets (Replace in production)
JWT_SECRET=development_jwt_secret_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d

# Business Logic Settings
MIN_CANCELLATION_NOTICE_HOURS=2
TIMEZONE=UTC
