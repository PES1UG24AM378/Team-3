{
  "name": "tutoring-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend API for Peer-to-Peer Tutoring Scheduler",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "node -e \"console.log('Backend syntax check passed')\"",
    "build": "node -e \"console.log('Backend build check passed')\"",
    "test": "node --test",
    "test:benchmark": "node --test test/latency.benchmark.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:backup": "node src/db/backup-check.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
