PORT=5000
NODE_ENV=development
API_PREFIX=/api
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tutoring_scheduler
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tutoring_scheduler
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=development_jwt_secret_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d
MIN_CANCELLATION_NOTICE_HOURS=2
TIMEZONE=UTC
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tutoring Scheduler <no-reply@tutoringscheduler.local>"
REMINDER_POLL_INTERVAL_MS=15000
REMINDER_RETRY_BASE_MINUTES=1
REMINDER_MAX_RETRIES=3